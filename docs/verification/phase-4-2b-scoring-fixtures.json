{
  "contractVersion": 2,
  "contractDocument": "docs/verification/phase-4-2b-scoring-contract.md",
  "status": "frozen for review; no routine implements these yet",
  "notes": [
    "Every scenario carries stable synthetic ids, explicit inputs, expected intermediates and an expected final value.",
    "Ids are fixture-local labels, not database rows. 4.2B.2 materialises them as transaction-scoped fixtures.",
    "Rounding: compare floats to 6 decimal places."
  ],

  "trending": [
    {
      "id": "trend-normalised-maths",
      "why": "components are normalised before weighting, so coefficients are real percentages",
      "entity": { "id": "e-trend-1", "created_at_days_ago": 10, "popularity_score": null, "geographic_boost": null, "seasonal_boost": null },
      "inputs": { "capped_views": 30, "capped_engagement": 5, "capped_contributions": 2 },
      "expected_intermediates": { "views_n": 0.06, "engagement_n": 0.025, "contributions_n": 0.04, "velocity": 0.0455, "base_popularity_n": 0, "geo_n": 0, "seasonal_n": 0, "age_factor": 1.1 },
      "expected_score": 0.02002
    },
    {
      "id": "trend-contribution-cap-two",
      "why": "per person per item: at most 1 review-side contribution plus 1 entity-linked post",
      "entity": { "id": "e-trend-2", "created_at_days_ago": 400 },
      "inputs": {
        "person": "u-trend-a",
        "reviews_in_window": ["r-1"],
        "entity_linked_posts_in_window": ["p-1", "p-2", "p-3"],
        "capped_views": 0,
        "capped_engagement": 0
      },
      "expected_intermediates": { "capped_contributions": 2, "contributions_n": 0.04, "velocity": 0.008, "age_factor": 1.0 },
      "expected_score": 0.0032
    },
    {
      "id": "trend-timeline-update-counts-once",
      "why": "a qualifying timeline update re-trends the item, but review + update never count twice",
      "entity": { "id": "e-trend-3", "created_at_days_ago": 400 },
      "inputs": {
        "person": "u-trend-b",
        "reviews_in_window": [],
        "review_outside_window": "r-old",
        "qualifying_timeline_updates_in_window": ["ru-1", "ru-2"],
        "entity_linked_posts_in_window": ["p-4"],
        "capped_views": 0,
        "capped_engagement": 0
      },
      "expected_intermediates": { "review_side_contribution": 1, "post_contribution": 1, "capped_contributions": 2, "contributions_n": 0.04, "velocity": 0.008 },
      "expected_score": 0.0032
    },
    {
      "id": "trend-anonymous-view-aggregate-cap",
      "why": "null-viewer rows cannot flood the input",
      "entity": { "id": "e-trend-4", "created_at_days_ago": 400 },
      "inputs": { "identified_capped_views": 10, "anonymous_rows_after_session_dedupe": 5000 },
      "expected_intermediates": { "anonymous_cap": 70, "capped_views": 80, "views_n": 0.16, "velocity": 0.08 },
      "expected_score": 0.032
    },
    {
      "id": "trend-view-by-reviewer-counts",
      "why": "entity_views has no review/post reference; there is no self-view to exclude",
      "entity": { "id": "e-trend-5", "created_at_days_ago": 400 },
      "inputs": { "viewer": "u-trend-c", "viewer_has_published_review_of_entity": true, "view_rows": 3 },
      "expected_intermediates": { "capped_views": 3 },
      "expected_note": "views count normally for reviewers of the item"
    },
    {
      "id": "trend-self-like-excluded",
      "why": "a like on one's own review or post gives no engagement credit",
      "entity": { "id": "e-trend-6", "created_at_days_ago": 400 },
      "inputs": {
        "likes": [
          { "actor": "u-author", "target": "r-own", "target_author": "u-author" },
          { "actor": "u-author", "target": "p-own", "target_author": "u-author" },
          { "actor": "u-other", "target": "r-own", "target_author": "u-author" },
          { "actor": "u-other", "target": "p-own", "target_author": "u-author" }
        ]
      },
      "expected_intermediates": { "capped_engagement": 2 },
      "expected_note": "only u-other's two likes count"
    },
    {
      "id": "trend-engagement-cap-per-actor-per-item",
      "why": "cap scope is actor x item x window, not actor x content row",
      "entity": { "id": "e-trend-7", "created_at_days_ago": 400 },
      "inputs": { "actor": "u-trend-d", "likes_on_reviews_of_entity": 3, "likes_on_entity_linked_posts": 4 },
      "expected_intermediates": { "raw_actor_likes": 7, "capped_engagement": 5 }
    },
    {
      "id": "trend-entity-creator-is-not-owner",
      "why": "whoever created the entity row is an ordinary participant",
      "entity": { "id": "e-trend-8", "created_by": "u-creator", "created_at_days_ago": 400 },
      "inputs": { "person": "u-creator", "reviews_in_window": ["r-creator"], "view_rows": 2, "capped_engagement": 0 },
      "expected_intermediates": { "capped_contributions": 1, "capped_views": 2 },
      "expected_note": "creator contributions and views are included"
    },
    {
      "id": "trend-null-and-negative-inputs-clamped",
      "why": "two-sided null-safe clamps guarantee the [0, 1.2] range",
      "entity": { "id": "e-trend-9", "created_at_days_ago": 400, "popularity_score": null, "geographic_boost": -5, "seasonal_boost": 3 },
      "inputs": { "capped_views": 0, "capped_engagement": 0, "capped_contributions": 0 },
      "expected_intermediates": { "base_popularity_n": 0, "geo_n": 0, "seasonal_n": 1.0, "velocity": 0, "age_factor": 1.0 },
      "expected_score": 0.15
    },
    {
      "id": "trend-legacy-stored-score-clamped",
      "why": "pre-v2 stored values are on an unbounded scale and must never be consumed raw",
      "inputs": { "stored_trending_score": 37.5 },
      "expected_intermediates": { "clamped_stored": 1.2, "trending_n": 1.0 }
    },
    {
      "id": "trend-post-double-linked-counts-once",
      "why": "post_entities UNION posts.entity_id, never UNION ALL",
      "entity": { "id": "e-trend-10", "created_at_days_ago": 400 },
      "inputs": { "person": "u-trend-e", "post": "p-both", "in_post_entities": true, "posts_entity_id_matches": true },
      "expected_intermediates": { "capped_contributions": 1, "contributions_n": 0.02, "velocity": 0.004 },
      "expected_score": 0.004
    },
    {
      "id": "trend-candidate-selection",
      "why": "candidate set is activity in 24 h union non-zero stored score",
      "candidates": [
        { "entity": "e-cand-1", "activity_24h": true, "stored_score": 0, "expected_selected": true },
        { "entity": "e-cand-2", "activity_24h": false, "stored_score": 0.4, "expected_selected": true, "expected_score_after_recompute": 0 },
        { "entity": "e-cand-3", "activity_24h": false, "stored_score": 0, "expected_selected": false }
      ]
    },
    {
      "id": "trend-privacy-private-review-excluded",
      "why": "private reviews never enter a global aggregate",
      "entity": { "id": "e-trend-11", "created_at_days_ago": 400 },
      "inputs": { "reviews_in_window": [{ "id": "r-private", "visibility": "private" }], "capped_views": 0, "capped_engagement": 0 },
      "expected_intermediates": { "capped_contributions": 0, "velocity": 0 },
      "expected_score": 0
    },
    {
      "id": "trend-canonicalisation-before-scoring",
      "why": "duplicate (user, entity) review rows collapse to the current one",
      "entity": { "id": "e-trend-12", "created_at_days_ago": 400 },
      "inputs": { "person": "u-trend-f", "review_rows_same_entity": ["r-old", "r-new"], "capped_views": 0, "capped_engagement": 0 },
      "expected_intermediates": { "selected_review": "r-new", "capped_contributions": 1 }
    },
    {
      "id": "trend-zero-activity-decays-to-zero",
      "why": "sparse data returns 0, never an error",
      "entity": { "id": "e-trend-13", "created_at_days_ago": 400, "popularity_score": null },
      "inputs": { "capped_views": 0, "capped_engagement": 0, "capped_contributions": 0 },
      "expected_score": 0
    }
  ],

  "influence": [
    {
      "id": "infl-positivity-invariance",
      "why": "identical reach/volume/engagement must score identically regardless of average rating",
      "category": "product",
      "cases": [
        { "user": "u-harsh", "average_rating_of_credited_reviews": 1.0 },
        { "user": "u-generous", "average_rating_of_credited_reviews": 5.0 }
      ],
      "shared_inputs": { "followers": 500, "credited_set_size": 10, "total_likes_on_credited_set": 250 },
      "expected_intermediates": { "reach": 0.175, "volume": 0.035, "avg_likes": 25, "engagement": 0.15 },
      "expected_score_both": 0.36
    },
    {
      "id": "infl-ten-posts-one-item-credit-one",
      "why": "anti-spam: earliest eligible post per (author, entity) only, for both terms",
      "category": "product",
      "user": "u-spammy",
      "inputs": { "followers": 0, "entity": "e-infl-1", "posts_about_entity": 10, "earliest_post": "p-first", "likes_on_p_first": 4, "likes_on_other_nine_posts": 36, "canonical_review_of_entity": null },
      "expected_intermediates": { "credited_set": ["p-first"], "credited_set_size": 1, "reach": 0, "volume": 0.0035, "credited_likes": 4, "avg_likes": 4, "engagement": 0.024 },
      "expected_score": 0.0275
    },
    {
      "id": "infl-multi-entity-post-attribution",
      "why": "one post linked to three items of the same type yields three credited rows",
      "category": "product",
      "user": "u-infl-a",
      "inputs": { "followers": 0, "post": "p-multi", "linked_entities": ["e-p1", "e-p2", "e-p3"], "linked_entity_types": ["product", "product", "product"], "likes_on_p_multi": 6 },
      "expected_intermediates": { "credited_set_size": 3, "volume": 0.0105, "credited_likes": 6, "avg_likes": 2, "engagement": 0.012 },
      "expected_score": 0.0225
    },
    {
      "id": "infl-uncategorised-post-excluded",
      "why": "a post with no linked entity contributes to no category",
      "user": "u-infl-b",
      "inputs": { "followers": 0, "posts": [{ "id": "p-unlinked", "linked_entities": [] }] },
      "expected_intermediates": { "credited_set_size": 0, "volume": 0, "engagement": 0 },
      "expected_score": 0
    },
    {
      "id": "infl-self-like-excluded",
      "why": "likes by the content's own author never count",
      "category": "book",
      "user": "u-infl-c",
      "inputs": { "followers": 0, "credited_set": ["r-b1", "p-b1"], "likes": [{ "actor": "u-infl-c", "target": "r-b1" }, { "actor": "u-infl-c", "target": "p-b1" }, { "actor": "u-x", "target": "r-b1" }, { "actor": "u-y", "target": "r-b1" }, { "actor": "u-z", "target": "p-b1" }, { "actor": "u-w", "target": "p-b1" }] },
      "expected_intermediates": { "credited_set_size": 2, "credited_likes": 4, "avg_likes": 2, "volume": 0.007, "engagement": 0.012 },
      "expected_score": 0.019
    },
    {
      "id": "infl-zero-like-rows-stay-in-denominator",
      "why": "credited content with no likes dilutes the average, as intended",
      "category": "movie",
      "user": "u-infl-d",
      "inputs": { "followers": 0, "credited_set": ["r-m1", "r-m2", "r-m3", "r-m4"], "credited_likes": 8 },
      "expected_intermediates": { "credited_set_size": 4, "avg_likes": 2, "volume": 0.014, "engagement": 0.012 },
      "expected_score": 0.026
    },
    {
      "id": "infl-canonical-15-type-domain",
      "why": "category domain is the canonical entity types, not the 5-bucket projection or legacy enum",
      "user": "u-infl-e",
      "inputs": { "post": "p-mixed", "linked_entity_types": ["product", "course", "experience"] },
      "expected_categories_credited": ["product", "course", "experience"],
      "expected_note": "legacy social_influence_scores rows on the old domain are deleted and recomputed, not translated"
    },
    {
      "id": "infl-sparse-user",
      "why": "new users score 0, never negative or NULL",
      "user": "u-new",
      "inputs": { "followers": 0, "credited_set_size": 0 },
      "expected_score": 0
    },
    {
      "id": "infl-saturation",
      "why": "all three terms saturate, so the score is bounded at 1",
      "user": "u-mega",
      "inputs": { "followers": 50000, "credited_set_size": 4000, "total_likes_on_credited_set": 900000 },
      "expected_intermediates": { "reach": 0.35, "volume": 0.35, "avg_likes_capped": 50, "engagement": 0.3 },
      "expected_score": 1.0
    }
  ],

  "personalized": [
    {
      "id": "pers-trending-does-not-overwhelm-interest",
      "why": "normalised terms keep trending at 20% of the decision",
      "items": [
        { "id": "e-pers-a", "interest_score": 5, "followed_reviewers_30d": 0, "stored_trending": 0, "expected_intermediates": { "interest_n": 1, "social_n": 0, "trending_n": 0 }, "expected_score": 0.5 },
        { "id": "e-pers-b", "interest_score": 0, "followed_reviewers_30d": 0, "stored_trending": 1.2, "expected_intermediates": { "interest_n": 0, "social_n": 0, "trending_n": 1 }, "expected_score": 0.2 }
      ],
      "expected_order": ["e-pers-a", "e-pers-b"]
    },
    {
      "id": "pers-null-interest-is-not-null-score",
      "why": "coalesce before clamp; a missing interest row must not null out the score",
      "item": { "id": "e-pers-c", "interest_score": null, "followed_reviewers_30d": null, "stored_trending": 0.6 },
      "expected_intermediates": { "interest_n": 0, "social_n": 0, "trending_n": 0.5 },
      "expected_score": 0.1
    },
    {
      "id": "pers-deterministic-tie-break",
      "why": "score DESC, trending_n DESC, id ASC — pagination must not shuffle",
      "items": [
        { "id": "e-pers-y", "interest_score": 1, "followed_reviewers_30d": 0, "stored_trending": 0, "expected_intermediates": { "interest_n": 0.2, "trending_n": 0 }, "expected_score": 0.1 },
        { "id": "e-pers-x", "interest_score": 0, "followed_reviewers_30d": 0, "stored_trending": 0.6, "expected_intermediates": { "interest_n": 0, "trending_n": 0.5 }, "expected_score": 0.1 }
      ],
      "expected_order": ["e-pers-x", "e-pers-y"]
    },
    {
      "id": "pers-clamped-inputs",
      "why": "out-of-range and negative stored values cannot break the [0, 1] output",
      "item": { "id": "e-pers-d", "interest_score": 9, "followed_reviewers_30d": 12, "stored_trending": 5 },
      "expected_intermediates": { "interest_n": 1, "social_n": 1, "trending_n": 1 },
      "expected_score": 1.0
    },
    {
      "id": "pers-reviewed-or-saved-excluded",
      "why": "candidate pool excludes items the viewer already reviewed or saved",
      "viewer": "u-pers-1",
      "items": [
        { "id": "e-pers-e", "viewer_reviewed": true, "expected_selected": false },
        { "id": "e-pers-f", "viewer_saved": true, "expected_selected": false },
        { "id": "e-pers-g", "expected_selected": true }
      ]
    },
    {
      "id": "pers-circle-review-counts-for-viewer",
      "why": "viewer-specific surface may use Circle-visible reviews the viewer is authorised to see",
      "viewer": "u-pers-2",
      "item": { "id": "e-pers-h", "reviews": [{ "author": "u-followed", "visibility": "circle_only", "viewer_authorised": true }, { "author": "u-stranger", "visibility": "private" }] },
      "expected_intermediates": { "followed_reviewers_30d": 1, "social_n": 0.2 },
      "expected_note": "the private stranger review is excluded; the Circle review counts here but never in a global aggregate"
    },
    {
      "id": "pers-sparse-user-trending-only",
      "why": "no interests and no follow activity → trending-only ranking with the trending reason",
      "viewer": "u-pers-3",
      "item": { "id": "e-pers-i", "interest_score": null, "followed_reviewers_30d": 0, "stored_trending": 1.2 },
      "expected_score": 0.2,
      "expected_reason": "Trending now"
    }
  ],

  "who_to_follow": [
    {
      "id": "wtf-features-computed-for-every-candidate",
      "why": "sources discover candidates; scoring is global",
      "viewer": "u-wtf-viewer",
      "max_mutuals_across_candidates": 4,
      "candidates": [
        { "id": "u-wtf-2", "sources": ["fof"], "mutuals": 4, "activity_7d": 12, "has_username": true, "has_avatar": true, "expected_intermediates": { "mutual_component": 1.0, "activity_component": 1.0, "profile_quality": 1.0 }, "expected_score": 1.0, "expected_reason": "fof" },
        { "id": "u-wtf-3", "sources": ["active"], "mutuals": 2, "activity_7d": 5, "has_username": true, "has_avatar": false, "expected_intermediates": { "mutual_component": 0.5, "activity_component": 0.5, "profile_quality": 0.5 }, "expected_score": 0.5, "expected_reason": "active" },
        { "id": "u-wtf-5", "sources": ["fof", "active", "fresh"], "mutuals": 2, "activity_7d": 5, "has_username": true, "has_avatar": false, "expected_score": 0.5, "expected_reason": "fof" }
      ],
      "expected_order": ["u-wtf-2", "u-wtf-3", "u-wtf-5"],
      "expected_order_rationale": "u-wtf-3 and u-wtf-5 tie at 0.5; id ASC decides"
    },
    {
      "id": "wtf-exclusions",
      "why": "self, already-followed and recently-shown candidates never appear",
      "viewer": "u-wtf-viewer",
      "candidates": [
        { "id": "u-wtf-viewer", "reason_excluded": "self", "expected_selected": false },
        { "id": "u-wtf-4", "already_followed": true, "expected_selected": false },
        { "id": "u-wtf-6", "impression_days_ago": 3, "expected_selected": false },
        { "id": "u-wtf-7", "impression_days_ago": 9, "expected_selected": true }
      ]
    },
    {
      "id": "wtf-activity-uses-public-published-reviews",
      "why": "activity counts posts plus public published canonical reviews only",
      "candidate": { "id": "u-wtf-8", "posts_7d": 2, "public_published_reviews_7d": 1, "private_reviews_7d": 4, "duplicate_review_rows_same_entity": 2 },
      "expected_intermediates": { "activity_7d": 3, "activity_component": 0.3 }
    }
  ],

  "reputation": [
    {
      "id": "rep-upper-clamp",
      "why": "reputation is clamped at 1000",
      "user": "u-rep-1",
      "inputs": { "eligible_contributions": 500, "helpful_flags_count": 0 },
      "expected_intermediates": { "base": 100, "contributions": 2500, "flag_accuracy": 0, "raw": 2600 },
      "expected_score": 1000
    },
    {
      "id": "rep-eligibility-predicates",
      "why": "draft, private and deleted records do not count; reviews use status/visibility, posts use is_deleted",
      "user": "u-rep-2",
      "inputs": {
        "reviews": [{ "id": "r-1", "status": "published", "visibility": "public" }, { "id": "r-2", "status": "draft" }, { "id": "r-3", "status": "published", "visibility": "private" }],
        "posts": [{ "id": "p-1", "status": "published", "is_deleted": false }, { "id": "p-2", "status": "published", "is_deleted": true }],
        "entities_created": [{ "id": "e-1", "is_deleted": false }],
        "helpful_flags_count": 2
      },
      "expected_intermediates": { "eligible_contributions": 3, "contributions": 15, "flag_accuracy": 6 },
      "expected_score": 121
    },
    {
      "id": "rep-negative-reviews-count-equally",
      "why": "rating value plays no part in reputation",
      "cases": [
        { "user": "u-rep-3", "eligible_contributions": 4, "average_rating": 1.0, "expected_score": 120 },
        { "user": "u-rep-4", "eligible_contributions": 4, "average_rating": 5.0, "expected_score": 120 }
      ]
    },
    {
      "id": "rep-canonical-one-review-per-item",
      "why": "duplicate review rows for one item count once",
      "user": "u-rep-5",
      "inputs": { "review_rows": [{ "id": "r-a", "entity": "e-z" }, { "id": "r-b", "entity": "e-z" }], "helpful_flags_count": 0 },
      "expected_intermediates": { "eligible_contributions": 1, "contributions": 5 },
      "expected_score": 105
    }
  ],

  "similarity": [
    {
      "id": "sim-insufficient-overlap-is-null",
      "why": "0 must stay distinguishable from 'no evidence'",
      "inputs": { "shared_entities": 2 },
      "expected_result": null
    },
    {
      "id": "sim-both-constant-same-level",
      "why": "zero-variance fallback: identical constant ratings are maximally close",
      "inputs": { "shared_entities": 5, "ratings_a": [5, 5, 5, 5, 5], "ratings_b": [5, 5, 5, 5, 5] },
      "expected_intermediates": { "pearson": "undefined", "mean_abs_diff": 0, "adjusted_similarity": 1.0, "confidence": 1.0 },
      "expected_result": 1.0
    },
    {
      "id": "sim-both-constant-opposite-levels",
      "why": "zero-variance fallback must not report agreement between 5s and 1s",
      "inputs": { "shared_entities": 5, "ratings_a": [5, 5, 5, 5, 5], "ratings_b": [1, 1, 1, 1, 1] },
      "expected_intermediates": { "mean_abs_diff": 4, "adjusted_similarity": 0.0, "confidence": 1.0 },
      "expected_result": 0.0
    },
    {
      "id": "sim-both-constant-different-levels",
      "why": "intermediate rating-level proximity",
      "inputs": { "shared_entities": 5, "ratings_a": [4, 4, 4, 4, 4], "ratings_b": [2, 2, 2, 2, 2] },
      "expected_intermediates": { "mean_abs_diff": 2, "adjusted_similarity": 0.5, "confidence": 1.0 },
      "expected_result": 0.5
    },
    {
      "id": "sim-overlap-confidence",
      "why": "3-4 shared entities are discounted by shared/5",
      "inputs": { "shared_entities": 3, "adjusted_similarity": 0.9 },
      "expected_intermediates": { "confidence": 0.6 },
      "expected_result": 0.54
    },
    {
      "id": "sim-null-preservation-for-callers",
      "why": "4.2B.3 callers must not coerce NULL to 0",
      "inputs": { "routine_result": null },
      "expected_caller_behaviour": "surface as 'not enough shared history'; `result || 0` and `result ?? 0` are forbidden"
    },
    {
      "id": "sim-public-only-population",
      "why": "similarity surfaces globally, so Circle and private reviews are excluded",
      "inputs": { "shared_public_entities": 3, "shared_circle_only_entities": 4 },
      "expected_intermediates": { "shared_entities_used": 3 }
    }
  ],

  "cross_cutting": [
    {
      "id": "xcut-private-never-global",
      "why": "private reviews are absent from trending, influence, reputation and similarity",
